<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GerenciadorDeFinancas.Converters"
             xmlns:local="clr-namespace:GerenciadorDeFinancas"
             x:Class="GerenciadorDeFinancas.PeoplePage"
             Title="Pessoas">
    <ContentPage.Resources>
        <converters:HexToBrushConverter x:Key="ColorToBrush" />
    </ContentPage.Resources>

    <RefreshView x:Name="Refresh"
                 Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="12">

                <Button Text="Adicionar pessoa"
                        Clicked="OnAddClicked"
                        HorizontalOptions="Fill" />

                <CollectionView x:Name="PeopleView">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma pessoa cadastrada ainda."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               Margin="4,16,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:PersonRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Ellipse Grid.Column="0"
                                         WidthRequest="12"
                                         HeightRequest="12"
                                         VerticalOptions="Center"
                                         StrokeThickness="0"
                                         Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Button Text="Editar"
                                            Clicked="OnEditClicked"
                                            CommandParameter="{Binding Id}"
                                            FontSize="12"
                                            Padding="10,4" />
                                    <Button Text="{Binding StatusActionText}"
                                            Clicked="OnToggleActiveClicked"
                                            CommandParameter="{Binding Id}"
                                            FontSize="12"
                                            Padding="10,4" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
