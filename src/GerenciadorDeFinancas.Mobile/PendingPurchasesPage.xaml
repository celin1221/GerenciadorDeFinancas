<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GerenciadorDeFinancas.Converters"
             xmlns:local="clr-namespace:GerenciadorDeFinancas"
             x:Class="GerenciadorDeFinancas.PendingPurchasesPage"
             Title="Pendentes">
    <ContentPage.Resources>
        <converters:MoneyToTextConverter x:Key="MoneyToText" />
    </ContentPage.Resources>

    <RefreshView x:Name="Refresh"
                 Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label Text="Compras aguardando divisão"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       FontAttributes="Bold"
                       Margin="4,0,0,0" />

                <CollectionView x:Name="PendingView">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma compra pendente."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               Margin="4,16,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:PendingPurchaseRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding CardName}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                    <Label Text="{Binding DateText}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding AmountCents, Converter={StaticResource MoneyToText}}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" />
                                    <Button Text="Dividir"
                                            Clicked="OnSplitClicked"
                                            CommandParameter="{Binding Id}"
                                            FontSize="12"
                                            Padding="10,4" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
