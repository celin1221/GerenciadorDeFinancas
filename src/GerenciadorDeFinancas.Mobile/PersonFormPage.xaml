<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerenciadorDeFinancas.PersonFormPage"
             Title="Nova pessoa">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Nome"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <Entry x:Name="NameEntry"
                   Placeholder="Nome da pessoa" />

            <Label Text="Cor (opcional)"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   Margin="0,12,0,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,4">
                <Ellipse x:Name="PreviewDot"
                         Grid.Column="0"
                         WidthRequest="36"
                         HeightRequest="36"
                         VerticalOptions="Center"
                         StrokeThickness="1"
                         Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Pré-visualização"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label x:Name="PreviewHexLabel"
                           FontSize="13" />
                </VerticalStackLayout>
                <Button x:Name="NoColorButton"
                        Grid.Column="2"
                        Text="Sem cor"
                        Clicked="OnNoColorClicked"
                        FontSize="12"
                        Padding="10,4"
                        VerticalOptions="Center" />
            </Grid>

            <FlexLayout x:Name="PaletteLayout"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        Margin="0,8,0,0" />

            <Label Text="Cor personalizada"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   Margin="0,12,0,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,4">
                <Label Grid.Column="0"
                       Text="R"
                       TextColor="#E53935"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Slider x:Name="RedSlider"
                        Grid.Column="1"
                        Maximum="255"
                        ValueChanged="OnComponentChanged"
                        VerticalOptions="Center" />
                <Label x:Name="RedValueLabel"
                       Grid.Column="2"
                       Text="0"
                       WidthRequest="34"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,4">
                <Label Grid.Column="0"
                       Text="G"
                       TextColor="#43A047"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Slider x:Name="GreenSlider"
                        Grid.Column="1"
                        Maximum="255"
                        ValueChanged="OnComponentChanged"
                        VerticalOptions="Center" />
                <Label x:Name="GreenValueLabel"
                       Grid.Column="2"
                       Text="0"
                       WidthRequest="34"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,4">
                <Label Grid.Column="0"
                       Text="B"
                       TextColor="#1E88E5"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Slider x:Name="BlueSlider"
                        Grid.Column="1"
                        Maximum="255"
                        ValueChanged="OnComponentChanged"
                        VerticalOptions="Center" />
                <Label x:Name="BlueValueLabel"
                       Grid.Column="2"
                       Text="0"
                       WidthRequest="34"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center" />
            </Grid>

            <Button Text="Salvar"
                    Clicked="OnSaveClicked"
                    Margin="0,24,0,0" />
            <Button Text="Cancelar"
                    Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
