<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GerenciadorDeFinancas.Converters"
             xmlns:local="clr-namespace:GerenciadorDeFinancas"
             x:Class="GerenciadorDeFinancas.InvoiceDetailPage"
             Title="Fatura">
    <ContentPage.Resources>
        <converters:MoneyToTextConverter x:Key="MoneyToText" />
    </ContentPage.Resources>

    <RefreshView x:Name="Refresh"
                 Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label x:Name="TitleLabel"
                       FontSize="20"
                       FontAttributes="Bold" />
                <Label x:Name="CardLabel"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Label x:Name="DatesLabel"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                    <Label Grid.Column="0"
                           Text="Total da fatura"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label x:Name="TotalLabel"
                           Grid.Column="1"
                           FontSize="17"
                           FontAttributes="Bold" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                <CollectionView x:Name="PurchasesView">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma compra nesta fatura."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:InvoicePurchaseRow">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPurchaseTapped"
                                                          CommandParameter="{Binding Id}"
                                                          NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontSize="15" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding DateText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                        <Label Text="{Binding Badge}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding HasBadge}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding StatusText}"
                                           FontSize="12"
                                           IsVisible="{Binding ShowStatus}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding AmountCents, Converter={StaticResource MoneyToText}}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
