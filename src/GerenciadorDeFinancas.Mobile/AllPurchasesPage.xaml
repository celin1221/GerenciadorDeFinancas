<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GerenciadorDeFinancas.Converters"
             xmlns:local="clr-namespace:GerenciadorDeFinancas"
             x:Class="GerenciadorDeFinancas.AllPurchasesPage"
             Title="Todas as compras">
    <ContentPage.Resources>
        <converters:MoneyToTextConverter x:Key="MoneyToText" />
    </ContentPage.Resources>

    <RefreshView x:Name="Refresh"
                 Refreshing="OnRefreshing">
        <CollectionView x:Name="PurchasesView">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma compra classificada nos últimos 3 meses."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       Margin="20,40,20,0"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.Header>
                <Label x:Name="CountLabel"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       FontAttributes="Bold"
                       Margin="20,16,20,4" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:AllPurchaseRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="20,8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding DateText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding CardText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding Badge}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding HasBadge}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding SplitText}"
                                   IsVisible="{Binding IsSplit}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding AmountCents, Converter={StaticResource MoneyToText}}"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
